rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isPlatformAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'student');
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || (resource.data != null && 'role' in resource.data && request.resource.data.role == resource.data.role) || isPlatformAdmin());

      match /events/{eventId} {
        function ownsEvent(data) {
          return data.userId == userId && data.id == eventId;
        }

        function validEvent(data) {
          return data.title is string
            && data.title.size() > 0
            && data.title.size() <= 300
            && data.type in ['hackathon', 'ctf', 'meetup', 'workshop', 'deadline', 'other']
            && data.mode in ['online', 'offline', 'hybrid']
            && data.status in ['upcoming', 'past', 'registered', 'skipped']
            && (!('raw_text' in data) || data.raw_text == null || (data.raw_text is string && data.raw_text.size() <= 100000))
            && data.confidence_score is number
            && data.confidence_score >= 0
            && data.confidence_score <= 1
            && data.created_at is string
            && data.updated_at is string;
        }

        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && ownsEvent(request.resource.data)
          && validEvent(request.resource.data);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && ownsEvent(resource.data)
          && ownsEvent(request.resource.data)
          && request.resource.data.created_at == resource.data.created_at
          && validEvent(request.resource.data);
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && ownsEvent(resource.data);
      }
    }

    // 2. SIES GST Public Community Feed (Admin publishes with clean empty state, Students toggle own attendance)
    match /communityEvents/{eventId} {
      allow read: if request.auth != null;

      // Creation requires platform admin and explicit empty initialization
      allow create: if isPlatformAdmin()
        && request.resource.data.attendees is list
        && request.resource.data.attendees.size() == 0
        && request.resource.data.attendeesCount is int
        && request.resource.data.attendeesCount == 0
        && request.resource.data.attendeePreviews is map
        && request.resource.data.attendeePreviews.keys().size() == 0;

      allow delete: if isPlatformAdmin();

      // Updates: Admin full access OR Student single-UID atomic attendance mutation
      allow update: if isPlatformAdmin() || (
        request.auth != null
        // 1. Only attendance array, count, initials preview map, and timestamp can be modified
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'attendeesCount', 'attendeePreviews', 'updated_at'])
        
        // 2. Joining branch (Strict UID ownership + Superset check + Single nested key diff)
        && (
          (
            // User was not present in attendees, now is present
            !(request.auth.uid in resource.data.attendees)
            && request.auth.uid in request.resource.data.attendees
            // All existing attendees preserved (anti-tampering superset check)
            && request.resource.data.attendees.hasAll(resource.data.attendees)
            && request.resource.data.attendees.size() == resource.data.attendees.size() + 1
            && request.resource.data.attendeesCount == resource.data.attendeesCount + 1
            // Initials validation & single-key diff on attendeePreviews
            && request.resource.data.attendeePreviews[request.auth.uid] is string
            && request.resource.data.attendeePreviews[request.auth.uid].size() <= 4
            && request.resource.data.attendeePreviews.diff(resource.data.attendeePreviews).affectedKeys().hasOnly([request.auth.uid])
          )
          // 3. Leaving branch (Strict UID ownership + Subset check + Single nested key diff)
          || (
            // User was present, now is removed
            request.auth.uid in resource.data.attendees
            && !(request.auth.uid in request.resource.data.attendees)
            // New list is an exact subset of old list (anti-tampering subset check)
            && resource.data.attendees.hasAll(request.resource.data.attendees)
            && request.resource.data.attendees.size() == resource.data.attendees.size() - 1
            && request.resource.data.attendeesCount == resource.data.attendeesCount - 1
            // User's key removed from attendeePreviews, no other key touched
            && !(request.auth.uid in request.resource.data.attendeePreviews)
            && request.resource.data.attendeePreviews.diff(resource.data.attendeePreviews).affectedKeys().hasOnly([request.auth.uid])
          )
        )
      );
    }

    match /extractionUsage/{usageId} {
      // Cloudflare Worker backend only (accessed via service account REST API)
      allow read, write: if false;
    }

    match /public_stats/{statId} {
      allow read: if true;
      allow create: if isPlatformAdmin() || (
        request.auth != null
        && request.resource.data.totalUsers is int
        && request.resource.data.totalUsers == 1
      );
      allow update: if isPlatformAdmin() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalUsers', 'last_active'])
        && request.resource.data.totalUsers == resource.data.totalUsers + 1
      );
      allow delete: if isPlatformAdmin();
    }
  }
}
