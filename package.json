{
  "name": "calendar-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react-native": "0.81.5",
    "@react-native/virtualized-lists": "0.81.5"
  },
  "scripts": {
    "start": "npm --workspace=apps/mobile start",
    "start:clear": "npm --workspace=apps/mobile run start:clear",
    "mobile": "npm --workspace=apps/mobile start",
    "mobile:android": "npm --workspace=apps/mobile run android",
    "mobile:ios": "npm --workspace=apps/mobile run ios",
    "mobile:web": "npm --workspace=apps/mobile run web",
    "build:shared": "npm --workspace=packages/shared run build",
    "postinstall": "npm --workspace=packages/shared run build && node scripts/patch-rn.js",
    "typecheck": "npm --workspace=packages/shared run typecheck && npm --workspace=apps/mobile run typecheck"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "is-arrayish": "^0.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5"
  }
}
